  "scripts": {
    "minify-locales": "tsx ../../scripts/minify-locales.ts",
    "rebuild-native": "electron-rebuild -f",
    "start": "cross-env PERF_TESTING=true electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:github-desktop-trampoline": "node src/githubDesktop/script/build-native-vendors.mjs",
    "build:github-desktop": "pnpm build:github-desktop-trampoline && cross-env NODE_ENV=production RELEASE_CHANNEL=production CIRCLE_SHA1=marknotepro node --import tsx ./node_modules/webpack-cli/bin/cli.js --config src/githubDesktop/upstream/webpack.renderer.production.ts",
    "build:unpack": "tsx ../../scripts/minify-locales.ts && electron-vite build",
    "build:win": "pnpm build:github-desktop && tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --win --x64 --publish never",
    "build:win:x64": "pnpm build:github-desktop && tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --win --x64 --publish never",
    "build:win:arm64": "pnpm build:github-desktop && tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --win --arm64 --publish never",
    "build:mac": "pnpm build:github-desktop && tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --mac --publish never",
    "build:mac:x64": "pnpm build:github-desktop && tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --mac --x64 --publish never",
    "build:mac:arm64": "pnpm build:github-desktop && tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --mac --arm64 --publish never",
    "build:linux": "pnpm build:github-desktop && tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --linux snap deb rpm tar.gz --x64 --publish never",
    "build:linux:x64": "pnpm build:github-desktop && tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --linux snap deb rpm tar.gz --x64 --publish never",
    "build:linux:arm64": "pnpm build:github-desktop && tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --linux AppImage tar.gz --arm64 --publish never",
    "perf:inspect": "cross-env PERF_TESTING=true electron-vite preview -- --inspect=5858",
    "perf:inspect-brk": "cross-env PERF_TESTING=true electron-vite preview -- --inspect-brk=5858",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "playwright test test/e2e",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:watch": "vue-tsc --noEmit -p tsconfig.json --watch"
  },
