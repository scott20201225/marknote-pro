+
+function createChaCha20Cipher(key, iv) {
+  try {
+    return crypto.createCipheriv('chacha20', key, iv);
+  } catch {
+    return new ChaCha20Cipher(key, iv);
+  }
+}
+
+module.exports = {
+  ChaCha20Cipher,
+  createChaCha20Cipher,
+};
