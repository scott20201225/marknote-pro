+  x[a] = (x[a] + x[b]) >>> 0;
+  x[d] = rotl(x[d] ^ x[a], 16);
+  x[c] = (x[c] + x[d]) >>> 0;
+  x[b] = rotl(x[b] ^ x[c], 12);
+  x[a] = (x[a] + x[b]) >>> 0;
+  x[d] = rotl(x[d] ^ x[a], 8);
+  x[c] = (x[c] + x[d]) >>> 0;
+  x[b] = rotl(x[b] ^ x[c], 7);
