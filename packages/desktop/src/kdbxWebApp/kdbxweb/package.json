{
    "name": "kdbxweb",
    "version": "2.2.0",
    "description": "Kdbx KeePass database reader for web",
    "main": "dist/kdbxweb.js",
    "private": false,
    "types": "dist/types/index.d.ts",
    "homepage": "https://keeweb.info",
    "repository": {
        "type": "git",
        "url": "https://github.com/keeweb/kdbxweb.git"
    },
    "author": {
        "name": "Antelle",
        "email": "keeweb@keeweb.info",
        "url": "https://antelle.net"
    },
    "packageManager": "pnpm@10.33.4",
    "engines": {
        "node": ">=20.19.0",
        "pnpm": ">=10"
    },
    "license": "MIT",
    "readme": "README.md",
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/antelle"
    },
    "scripts": {
        "test": "pnpm run tests:node",
        "start": "pnpm run lint && pnpm run build",
        "tsc": "tsc",
        "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
        "lint": "eslint lib test conf scripts",
        "build": "pnpm run clean && pnpm run tests:cover && pnpm run pack:tests && pnpm run pack:dist-debug && pnpm run pack:dist-prod",
        "clean": "rimraf dist .nyc_output coverage",
        "pack:dist-prod": "tsx node_modules/webpack/bin/webpack.js --progress --mode=production --config conf/webpack.config.ts",
        "pack:dist-debug": "tsx node_modules/webpack/bin/webpack.js --progress --mode=development --devtool source-map --config conf/webpack.config.ts",
        "webpack-stats": "tsx node_modules/webpack/bin/webpack.js --mode=production --json --config conf/webpack.config.ts > dist/stats.json",
        "pack:tests": "tsx node_modules/webpack/bin/webpack.js --progress --config conf/webpack.tests.config.ts",
        "tests:node": "vitest run",
        "tests:cover": "vitest run --coverage",
        "script:dump-header": "tsx scripts/dump-header",
        "script:kdbx-size-profiler": "tsx scripts/kdbx-size-profiler",
        "script:kdbx-to-xml": "tsx scripts/kdbx-to-xml",
        "script:make-big-files": "tsx scripts/make-big-files",
        "script:save-perf-test": "tsx scripts/save-perf-test"
    },
    "keywords": [
        "kdbx",
        "keepass"
    ],
    "devDependencies": {
      "@istanbuljs/nyc-config-typescript": "^1.0.2",
      "@nodelib/fs.walk": "^1.2.8",
      "@types/expect.js": "^0.3.29",
      "@types/mocha": "^9.0.0",
      "@types/node": "^20.19.0",
      "@types/terser-webpack-plugin": "^5.0.3",
      "@typescript-eslint/eslint-plugin": "^8.61.1",
      "@typescript-eslint/parser": "^8.61.1",
      "@vitest/coverage-v8": "^4.1.9",
      "base64-loader": "^1.0.0",
      "eslint": "^9.39.4",
      "eslint-config-prettier": "^9.1.0",
      "eslint-plugin-chai-friendly": "^1.0.1",
      "eslint-plugin-import": "^2.31.0",
      "eslint-plugin-n": "17.15.0",
      "eslint-plugin-prettier": "^5.2.1",
      "eslint-plugin-promise": "^7.2.1",
      "eslint-plugin-standard": "^4.1.0",
      "eslint-plugin-mocha": "^10.5.0",
      "expect.js": "^0.3.1",
      "exports-loader": "^3.0.0",
      "prettier": "^3.8.4",
      "prettier-eslint": "^16.3.0",
      "rimraf": "^3.0.2",
      "source-map-support": "^0.5.19",
      "stats-webpack-plugin": "^0.7.0",
      "terser-webpack-plugin": "^5.2.3",
      "ts-loader": "^9.2.5",
      "tsx": "^4.22.4",
      "typescript": "5.7.2",
      "vitest": "^4.1.9",
      "webpack": "^5.108.4",
      "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "@xmldom/xmldom": "^0.8.10",
        "fflate": "^0.7.1"
    }
}
