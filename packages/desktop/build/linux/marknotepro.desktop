[Desktop Entry]
Name=MarkNotePro
Comment=Next generation markdown editor
Exec=marknotepro %F
Terminal=false
Type=Application
Icon=marknotepro
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=marknotepro;
StartupWMClass=marknotepro
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=marknotepro --new-window %F
Icon=marknotepro
